<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service class="Frosh\BunnycdnMediaStorage\Adapter\BunnyCdnFactory"
                 id="Shopware\Core\Framework\Adapter\Filesystem\FilesystemFactory.bunnycdn">
            <tag name="shopware.filesystem.factory"/>
        </service>

        <service id="Frosh\BunnycdnMediaStorage\Storefront\Subscriber\SitemapPageSubscriber">
            <argument type="string">%shopware.cdn.url%</argument>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="Frosh\BunnycdnMediaStorage\Listener\ResponseListener">
            <argument>%shopware.filesystem.public.url%</argument>
            <argument>%shopware.filesystem.sitemap.url%</argument>
            <argument>%shopware.filesystem.theme.url%</argument>
            <argument>%shopware.filesystem.asset.url%</argument>
            <tag name="kernel.event_listener" event="kernel.response" method="onKernelResponse" />
        </service>

        <service id="Frosh\BunnycdnMediaStorage\Service\CdnHealthCheckService">
            <argument type="service" id="cache.system"/>
            <argument type="service" id="monolog.logger.bunnycdn_fallback" on-invalid="null" />
            <argument>%shopware.filesystem.public.url%</argument>
            <argument>%shopware.filesystem.public.config.fallbackEnabled%</argument>
        </service>

        <service id="Frosh\BunnycdnMediaStorage\Core\Content\Media\Infrastructure\Url\FallbackUrlGenerator"
                 decorates="Shopware\Core\Content\Media\Infrastructure\Url\UrlGenerator"
                 decoration-priority="-10">
            <argument type="service" id="Frosh\BunnycdnMediaStorage\Core\Content\Media\Infrastructure\Url\FallbackUrlGenerator.inner"/>
            <argument type="service" id="Frosh\BunnycdnMediaStorage\Service\CdnHealthCheckService"/>
            <argument>%env(APP_URL)%</argument>
        </service>

    </services>
</container>